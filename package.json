{
  "name": "instagram-studio-workspace",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "npm run build:core",
    "build:core": "npm run build --workspace @saraivabr/instagram-studio-kit",
    "build": "npm run build:core && npm run app:build",
    "typecheck": "npm run build:core && npm run typecheck --workspaces --if-present",
    "test": "npm run build:core && node --test tests/*.test.mjs",
    "test:app": "node scripts/test-app.mjs",
    "demo": "npm run dev --workspace instagram-studio-app",
    "dev": "npm run build:core && npm run demo",
    "start": "npm run start --workspace instagram-studio-app",
    "app:build": "npm run build --workspace instagram-studio-app",
    "app:install": "npm run build:core",
    "demo:sdk": "npm run build:core && node examples/server.mjs",
    "pack:core": "npm pack --workspace @saraivabr/instagram-studio-kit",
    "verify": "npm test && npm run typecheck && npm run app:build && npm run test:app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saraivabr/instagram-studio-kit.git"
  }
}
