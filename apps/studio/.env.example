# Copie para apps/studio/.env.local. O app não lê automaticamente .env na raiz.
# Sem chave e modelos, o app usa artes de demonstração sem chamadas pagas.
# Informe chave e ambos os modelos para ativar IA real. Reinicie o app após editar.
# Credenciais são somente do servidor; nunca use NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_TEXT_MODEL=

# Opcional. Defaults: feed/story=1024x1536, square=1024x1024.
# GPT Image 1/1-mini/1.5 exigem tamanhos standard. Overrides custom exigem
# modelo compatível (por exemplo GPT Image 2), múltiplos de 16 e proporção válida.
# O adapter local recorta o resultado para 4:5, 1:1 ou 9:16.
OPENAI_IMAGE_SIZE_FEED=
OPENAI_IMAGE_SIZE_SQUARE=
OPENAI_IMAGE_SIZE_STORY=

# Opcional. Caminho absoluto recomendado; padrão .studio-data dentro do app.
# Contém SQLite, fila e imagens privadas. Evite pasta sincronizada/OneDrive.
STUDIO_DATA_DIR=

# Novos jobs por organização por dia UTC. Carrossel=8, pesquisa=1, referência=0.
# Falhas e retries novos contam; o mesmo UUID não reserva de novo.
STUDIO_DAILY_GENERATION_LIMIT=20

# Opcional. Para habilitar orçamento estimado, preencha ambos com valores positivos.
# Reserva por job, sem medir a cobrança real do provedor; falhas não liberam a reserva.
STUDIO_DAILY_BUDGET_USD=
STUDIO_ESTIMATED_GENERATION_COST_USD=

# Publicação, Direct e métricas exigem adapters sociais e autorização do anfitrião.
# Esta versão do aplicativo não consome ZERNIO_API_KEY nem implementa OAuth Meta.
